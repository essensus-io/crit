{
  "name": "@crit/cli",
  "version": "0.0.0",
  "description": "Local-first AI code review in your terminal, powered by the agent CLI you already use",
  "keywords": [
    "ai",
    "claude-code",
    "cli",
    "code-review",
    "codex",
    "cursor",
    "mcp"
  ],
  "license": "MIT",
  "bin": {
    "crit": "./dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node -e \"const f=require('fs');f.cpSync('../../packages/schema/json','schema',{recursive:true});f.copyFileSync('../../README.md','README.md')\"",
    "check-types": "tsc -p ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crit/core": "workspace:*",
    "@crit/mcp": "workspace:*",
    "@crit/providers": "workspace:*",
    "@crit/schema": "workspace:*",
    "@crit/store": "workspace:*",
    "@crit/testkit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}

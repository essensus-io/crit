{
  "title": "crit review output (JSON fallback when MCP is unavailable)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "nit"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "performance",
              "maintainability",
              "style",
              "test"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "failureScenario": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ruleIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "summary",
              "patch"
            ]
          }
        },
        "required": [
          "file",
          "range",
          "anchor",
          "severity",
          "category",
          "title",
          "explanation",
          "confidence"
        ]
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "findings",
    "summary"
  ]
}

{
  "title": "crit config (.crit/config.json, ~/.config/crit/config.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "lenses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "correctness",
          "security",
          "performance",
          "maintainability",
          "style",
          "test"
        ]
      }
    },
    "severityThreshold": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ]
    },
    "rules": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user",
              "project",
              "global"
            ]
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgetTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxShards": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confirmTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "shardTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxFileTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    }
  },
  "additionalProperties": false
}

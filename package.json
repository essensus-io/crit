{
  "name": "crit-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "CRIT_LIVE=1 vitest run --project live",
    "fixtures:record": "node scripts/record-fixtures.ts",
    "lint": "oxlint",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check"
  },
  "devDependencies": {
    "@crit/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
